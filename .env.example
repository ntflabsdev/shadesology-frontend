# Payload CMS uses the same MongoDB database as the API.
DATABASE_URI=mongodb://127.0.0.1:27017/shadesology
DB_NAME=shadesology
PAYLOAD_SECRET=replace_with_a_random_secret_at_least_32_characters

# S3 storage. Keep the private bucket's Block Public Access enabled.
AWS_REGION=us-east-1
S3_BUCKET_PUBLIC=shadesology-media-public
S3_BUCKET_PRIVATE=shadesology-private-docs
S3_PUBLIC_BASE_URL=https://shadesology-media-public.s3.us-east-1.amazonaws.com
# Browser uploads need this HTTPS S3 origin allowed by the frontend CSP.
S3_PRIVATE_BASE_URL=https://shadesology-private-docs.s3.us-east-1.amazonaws.com
S3_CSP_ORIGINS=https://shadesology-private-docs.s3.us-east-1.amazonaws.com
S3_SIGNED_URL_EXPIRES=3600

# Optional GA4 measurement; the script and events are disabled until analytics consent is granted.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional local IAM credentials; hosted environments should use workload roles.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
